        else:
            st.error("❌ No models found!")
            st.code("ollama pull llama3.2:3b\nollama pull gemma3:4b\nollama pull gemma2:2b")
        
        st.divider()
        
        st.markdown("### 📊 Statistics")
        st.metric("Total Comparisons", st.session_state.total_comparisons)
        st.metric("Questions Asked", len(st.session_state.chat_history))
        
        if st.session_state.chatbot.faq_loaded:
            st.success(f"✅ {len(st.session_state.chatbot.faq_data)} FAQs")
        
        st.divider()
        
        # Sample questions that trigger responses
        st.markdown("### 💡 Sample Questions")
        samples = [
            "How do I apply to TAR UMT?",
            "What facilities are available?",
            "How much are the fees?",
            "What programmes are offered?",
            "Where is TAR UMT located?"
        ]
        
        for sample in samples:
            if st.button(sample, key=f"sample_{hash(sample)}", use_container_width=True):
                st.session_state.pending_query = sample
                st.rerun()
        
        st.divider()
        
        if st.button("🗑️ Clear All History", use_container_width=True):
            st.session_state.chat_history = []
            st.session_state.total_comparisons = 0
            st.rerun()
    
    # Process pending query from sample button
    if st.session_state.pending_query:
        query_to_process = st.session_state.pending_query
        st.session_state.pending_query = None
        process_query(query_to_process)
        st.rerun()
    
    # FIXED: Display chat history - OLDEST at TOP, LATEST at BOTTOM
    if st.session_state.chat_history:
        st.markdown("## 💬 Chat History")
        
        # Show history in NORMAL order (oldest first, latest last)
        for i, chat in enumerate(st.session_state.chat_history):
            with st.container():
                st.markdown(f'<div class="chat-history">', unsafe_allow_html=True)
                
                # Question
                st.markdown(f'<div class="question-text">❓ {chat["query"]}</div>', 
                           unsafe_allow_html=True)
                
                # Responses in 3 columns
                col1, col2, col3 = st.columns(3)
                
                results = chat['results']
                fastest_model = chat.get('fastest_model')
                most_detailed = chat.get('most_detailed')
                
                columns = [col1, col2, col3]
                for j, model in enumerate(st.session_state.selected_models):
                    with columns[j]:
                        result = results.get(model['name'], {})
                        is_fastest = model['name'] == fastest_model
                        is_detailed = model['name'] == most_detailed
                        display_model_response(model, result, is_fastest, is_detailed)
                
                # Intent badge with link
                if chat.get('intent'):
                    intent = chat['intent']
                    intent_info = st.session_state.chatbot.get_intent_info(intent)
                    
                    if intent_info:
                        icon = intent_info['icon']
                        url = intent_info['url']
                        
                        badge_html = f'''
                        <a href="{url}" target="_blank" class="intent-badge">
                            {icon} {intent.title()} → Click to learn more
                        </a>
                        '''
                        st.markdown(badge_html, unsafe_allow_html=True)
                    
                    # Display quick action buttons
                    display_quick_actions(intent)
                
                # Summary
                if chat.get('faq_matches', 0) > 0:
                    st.info(f"📚 FAQ Matches: {chat.get('faq_matches', 0)}")
                
                st.markdown('</div>', unsafe_allow_html=True)
                st.markdown("---")
    
    else:
        st.info("👋 Welcome! Ask a question below or click a sample question in the sidebar!")
    
    # Input area at BOTTOM
    st.markdown("## 💬 Ask Your Question")
    
    col1, col2 = st.columns([4, 1])
    
    with col1:
        query = st.text_input(
            "Type your question here:", 
            placeholder="e.g., How do I apply to TAR UMT?",
            key="main_query",
            label_visibility="collapsed"
        )
    
    with col2:
        compare_button = st.button("🚀 Compare Models", type="primary", use_container_width=True)
    
    # Process manual query
    if compare_button and query:
        process_query(query)
        st.rerun()
    
    # Footer
    st.markdown("---")
