    def load_faq_dataset(self):
        """Load FAQ dataset"""
        try:
            possible_paths = [
                "TARUMT_FAQ.csv",
                "dataset/TARUMT_FAQ.csv",
                "./TARUMT_FAQ.csv"
            ]
            
            for path in possible_paths:
                if Path(path).exists():
                    self.faq_data = pd.read_csv(path, encoding='utf-8')
                    self.faq_loaded = True
                    self.faq_data.columns = self.faq_data.columns.str.strip()
                    return True
            return False
        except Exception as e:
            print(f"Error loading FAQ: {e}")
            return False
    
    def search_faq(self, query, top_n=2):
        """Search FAQ for context"""
        if not self.faq_loaded:
            return []
        
        try:
            query_lower = query.lower()
            results = []
            
            question_col = None
            answer_col = None
            
            for col in self.faq_data.columns:
                col_lower = col.lower()
                if 'question' in col_lower or 'q' == col_lower:
                    question_col = col
                elif 'answer' in col_lower or 'a' == col_lower:
                    answer_col = col
            
            if not question_col or not answer_col:
                return []
            
            for idx, row in self.faq_data.iterrows():
                question = str(row[question_col]).lower()
                answer = str(row[answer_col])
                
                if any(word in question for word in query_lower.split()):
                    results.append({
                        'question': row[question_col],
                        'answer': answer,
                        'relevance': sum(word in question for word in query_lower.split())
                    })
            
            results.sort(key=lambda x: x['relevance'], reverse=True)
            return results[:top_n]
        except:
            return []
    
    def detect_intent(self, message):
        """Detect intent"""
        message_lower = message.lower()
        
        for category, data in self.knowledge_base.items():
            for keyword in data["keywords"]:
                if keyword in message_lower:
                    return category
        return None
    
    def get_intent_info(self, intent):
        """Get intent information"""
        if intent and intent in self.knowledge_base:
            return self.knowledge_base[intent]
        return None
    
    def generate_single_model_response(self, model_name, query, context=""):
        """Generate response from ONE model"""
        start_time = time.time()
        
        try:
            if context:
                full_prompt = f"{self.system_prompt}\n\nContext:\n{context}\n\nQuestion: {query}\n\nAnswer:"
            else:
                full_prompt = f"{self.system_prompt}\n\nQuestion: {query}\n\nAnswer:"
            
            payload = {
                "model": model_name,
                "prompt": full_prompt,
                "stream": False,
                "options": {
                    "temperature": 0.7,
                    "num_predict": 150,
                    "num_ctx": 2048,
                    "top_p": 0.9,
                    "top_k": 40
                }
            }
            
            response = requests.post(
                self.api_endpoint,
                json=payload,
                timeout=60
            )
            
            response_time = time.time() - start_time
            
            if response.status_code == 200:
                result = response.json()
                bot_response = result.get("response", "").strip()
                
                # FIXED: Clean up citation artifacts and unwanted markers
                import re
                # Remove citation markers like [contentReference[oaicite:71]{index=71}]
                bot_response = re.sub(r'\[contentReference\[oaicite:\d+\]\{index=\d+\}\]', '', bot_response)
                # Remove any other citation patterns
                bot_response = re.sub(r'\[oaicite:\d+\]', '', bot_response)
                bot_response = re.sub(r'\{index=\d+\}', '', bot_response)
                # Remove extra whitespace
                bot_response = ' '.join(bot_response.split())
                bot_response = bot_response.strip()
                
                return {
                    'success': True,
                    'response': bot_response,
                    'response_time': response_time,
                    'word_count': len(bot_response.split()),
                    'char_count': len(bot_response),
                    'model': model_name
                }
            else:
                return {
                    'success': False,
                    'response': f"Error: Model returned status {response.status_code}",
                    'response_time': response_time,
                    'word_count': 0,
                    'model': model_name
                }
        
        except requests.exceptions.Timeout:
            return {
                'success': False,
                'response': "⏱ Timeout - Model took too long",
                'response_time': 60.0,
                'word_count': 0,
                'model': model_name
            }
        except Exception as e:
            return {
                'success': False,
                'response': f"❌ Error: {str(e)}",
                'response_time': time.time() - start_time,
                'word_count': 0,
                'model': model_name
            }
    
    def generate_multi_model_responses(self, query, models_to_use):
        """Generate responses from multiple models simultaneously"""
        faq_results = self.search_faq(query)
        context = ""
        if faq_results:
            context = "Relevant Information:\n"
            for result in faq_results:
                context += f"Q: {result['question']}\nA: {result['answer']}\n\n"
        
        intent = self.detect_intent(query)
        
        results = {}
        with ThreadPoolExecutor(max_workers=len(models_to_use)) as executor:
            future_to_model = {
                executor.submit(self.generate_single_model_response, model['name'], query, context): model
                for model in models_to_use
            }
            
            for future in as_completed(future_to_model):
                model = future_to_model[future]
                try:
                    result = future.result()
                    results[model['name']] = result
                except Exception as e:
                    results[model['name']] = {
                        'success': False,
                        'response': f"Error: {str(e)}",
                        'response_time': 0,
                        'word_count': 0,
                        'model': model['name']
                    }
        
        return results, intent, len(faq_results)
    
    def check_available_models(self):
        """Check available models"""
        try:
            response = requests.get(f"{self.base_url}/api/tags", timeout=5)
            if response.status_code == 200:
                data = response.json()
                return [model['name'] for model in data.get('models', [])]
            return []
        except:
            return []


