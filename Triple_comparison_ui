def process_query(query):
    """Process query and add to history"""
    if not query or not query.strip():
        return
    
    # Show loading
    st.markdown('<div class="loading-text">⏳ Querying all models simultaneously...</div>', 
               unsafe_allow_html=True)
    
    with st.spinner("Processing..."):
        results, intent, faq_matches = st.session_state.chatbot.generate_multi_model_responses(
            query, 
            st.session_state.selected_models
        )
    
    # Find winners
    successful_results = {k: v for k, v in results.items() if v['success']}
    
    if successful_results:
        fastest_model = min(successful_results.items(), key=lambda x: x[1]['response_time'])[0]
        most_detailed = max(successful_results.items(), key=lambda x: x[1].get('word_count', 0))[0]
    else:
        fastest_model = None
        most_detailed = None
    
    # Save to history
    st.session_state.chat_history.append({
        'query': query,
        'results': results,
        'intent': intent,
        'faq_matches': faq_matches,
        'fastest_model': fastest_model,
        'most_detailed': most_detailed,
        'timestamp': datetime.now().isoformat()
    })
    
    st.session_state.total_comparisons += 1


