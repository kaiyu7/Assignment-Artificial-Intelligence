    def detect_intent(self, query):
        """Simple intent detection"""
        query_lower = query.lower()
        
        intent_keywords = {
            'admission': ['apply', 'application', 'entry', 'requirement', 'enroll'],
            'facilities': ['library', 'gym', 'cafeteria', 'lab', 'facility'],
            'calendar': ['semester', 'calendar', 'exam', 'break', 'schedule'],
            'fees': ['fee', 'tuition', 'cost', 'scholarship', 'financial'],
            'contact': ['contact', 'email', 'phone', 'call', 'location', 'address'],
            'programs': ['program', 'course', 'study', 'major', 'degree']
        }
        
        for intent, keywords in intent_keywords.items():
            if any(keyword in query_lower for keyword in keywords):
                return intent
        return 'unknown'
    
    def check_model_available(self, model_name):
        """Check if model is installed"""
        try:
            response = requests.get(f"{self.base_url}/api/tags", timeout=5)
            if response.status_code == 200:
                models = [m['name'] for m in response.json().get('models', [])]
                return model_name in models
        except:
            pass
        return False
    
    def generate_response_directly(self, model_name, query):
        """
        AUTOMATED: Call Ollama API directly with any model
        No need to change chatbot code!
        """
        start_time = time.time()
        
        try:
            system_prompt = """You are TAR UMT Student Assistant. Answer questions about TAR UMT concisely in under 100 words. Be helpful and accurate."""
            
            payload = {
                "model": model_name,
                "prompt": f"{system_prompt}\n\nQuestion: {query}\n\nAnswer:",
                "stream": False,
                "options": {
                    "temperature": 0.7,
                    "num_predict": 150,
                    "num_ctx": 2048
                }
            }
            
            response = requests.post(
                f"{self.base_url}/api/generate",
                json=payload,
                timeout=60
            )
            
            response_time = time.time() - start_time
            
            if response.status_code == 200:
                result = response.json()
                bot_response = result.get("response", "").strip()
                predicted_intent = self.detect_intent(query)
                return bot_response, predicted_intent, response_time, True
            else:
                return f"Error: {response.status_code}", None, response_time, False
                
        except requests.exceptions.Timeout:
            return "Timeout", None, time.time() - start_time, False
        except Exception as e:
            return f"Error: {str(e)}", None, time.time() - start_time, False
    
    def calculate_metrics(self, reference, candidate):
        """Calculate multiple quality metrics"""
        ref_words = set(reference.lower().split())
        cand_words = set(candidate.lower().split())
        
        # BLEU (word overlap)
        if len(cand_words) > 0:
            bleu = len(ref_words & cand_words) / len(cand_words)
        else:
            bleu = 0.0
        
        # Jaccard similarity
        union = len(ref_words | cand_words)
        jaccard = len(ref_words & cand_words) / union if union > 0 else 0.0
        
        # Length ratio
        length_ratio = min(len(candidate), len(reference)) / max(len(candidate), len(reference), 1)
        
        return {
            'bleu': bleu,
            'jaccard': jaccard,
            'length_ratio': length_ratio
        }
    
    def calculate_keyword_coverage(self, response, keywords):
        """Check how many keywords are mentioned"""
        response_lower = response.lower()
        covered = sum(1 for kw in keywords if kw in response_lower)
        return covered / len(keywords) if keywords else 0.0
    
    def test_model_automatically(self, model_name):
        """
        AUTOMATED: Test one model completely
        No manual intervention needed!
        """
        print(f"\n{'='*70}")
        print(f"🤖 AUTO-TESTING: {model_name}")
        print(f"{'='*70}")
        
        if not self.check_model_available(model_name):
            print(f"  ⚠ Model not installed! Run: ollama pull {model_name}")
            return None
        
        y_true = []
        y_pred = []
        response_times = []
        bleu_scores = []
        jaccard_scores = []
        length_ratios = []
        keyword_coverages = []
        success_count = 0
        response_lengths = []
        
        for i, test in enumerate(self.test_cases, 1):
            print(f"  [{i}/{len(self.test_cases)}] Testing: {test['query'][:45]}...")
            
            response, intent, resp_time, success = self.generate_response_directly(model_name, test['query'])
            
            if success:
                success_count += 1
                y_true.append(test['expected_intent'])
                y_pred.append(intent if intent else 'unknown')
                response_times.append(resp_time)
                
                # Calculate quality metrics
                metrics = self.calculate_metrics(test['reference_answer'], response)
                bleu_scores.append(metrics['bleu'])
                jaccard_scores.append(metrics['jaccard'])
                length_ratios.append(metrics['length_ratio'])
                
                # Keyword coverage
                coverage = self.calculate_keyword_coverage(response, test['keywords'])
                keyword_coverages.append(coverage)
                
                # Response length
                response_lengths.append(len(response.split()))
            else:
                print(f"    ⚠ Failed: {response}")
        
        if success_count == 0:
            print(f"  ✗ All tests failed for {model_name}")
            return None
        
        # Calculate metrics
        labels = ['admission', 'facilities', 'calendar', 'fees', 'contact', 'programs']
        
        precision = precision_score(y_true, y_pred, average='weighted', labels=labels, zero_division=0)
        recall = recall_score(y_true, y_pred, average='weighted', labels=labels, zero_division=0)
        f1 = f1_score(y_true, y_pred, average='weighted', labels=labels, zero_division=0)
        accuracy = accuracy_score(y_true, y_pred)
        
        results = {
            'model_name': model_name,
            'timestamp': datetime.now().isoformat(),
            'success_rate': success_count / len(self.test_cases),
            'metrics': {
                'precision': float(precision),
                'recall': float(recall),
                'f1_score': float(f1),
                'accuracy': float(accuracy),
                'avg_bleu': float(np.mean(bleu_scores)),
                'avg_jaccard': float(np.mean(jaccard_scores)),
                'avg_length_ratio': float(np.mean(length_ratios)),
                'avg_keyword_coverage': float(np.mean(keyword_coverages)),
                'avg_response_time': float(np.mean(response_times)),
                'min_response_time': float(min(response_times)),
                'max_response_time': float(max(response_times)),
                'std_response_time': float(np.std(response_times)),
                'avg_response_length': float(np.mean(response_lengths))
            },
            'detailed_data': {
                'response_times': response_times,
                'bleu_scores': bleu_scores,
                'jaccard_scores': jaccard_scores,
                'keyword_coverages': keyword_coverages,
                'response_lengths': response_lengths
            }
        }
        
        # Save
        safe_name = model_name.replace(':', '_').replace(' ', '_')
        filename = f"{self.output_folder}/{safe_name}_results.json"
        with open(filename, 'w') as f:
            json.dump(results, f, indent=2)
        
        print(f"\n  ✓ {model_name} tested successfully!")
        print(f"    F1-Score: {f1:.3f}")
        print(f"    Accuracy: {accuracy:.3f}")
        print(f"    Avg Time: {np.mean(response_times):.2f}s")
        print(f"    Avg BLEU: {np.mean(bleu_scores):.3f}")
        print(f"    Keyword Coverage: {np.mean(keyword_coverages):.1%}")
        
        self.all_results[model_name] = results
        return results
    
