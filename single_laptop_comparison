    def plot_overall_score(self):
        """Calculate and plot overall performance score"""
        fig, ax = plt.subplots(figsize=(12, 7))
        
        models = list(self.all_results.keys())
        overall_scores = []
        
        for model in models:
            m = self.all_results[model]['metrics']
            
            # Weighted overall score
            score = (
                m['f1_score'] * 0.25 +           # 25% weight
                m['avg_bleu'] * 0.20 +           # 20% weight
                m['avg_keyword_coverage'] * 0.15 +  # 15% weight
                (1 / (m['avg_response_time'] + 0.1)) * 0.1 * 0.20 +  # 20% weight (speed)
                m['accuracy'] * 0.20             # 20% weight
            )
            overall_scores.append(score)
        
        colors = ['#3b82f6', '#10b981', '#f59e0b', '#ef4444', '#8b5cf6']
        bars = ax.bar(models, overall_scores, color=colors[:len(models)],
                     alpha=0.8, edgecolor='black', linewidth=2)
        
        # Highlight winner
        winner_idx = overall_scores.index(max(overall_scores))
        bars[winner_idx].set_edgecolor('gold')
        bars[winner_idx].set_linewidth(4)
        
        for bar, score in zip(bars, overall_scores):
            ax.text(bar.get_x() + bar.get_width()/2., bar.get_height(),
                   f'{score:.3f}', ha='center', va='bottom',
                   fontsize=12, fontweight='bold')
        
        ax.text(winner_idx, max(overall_scores) * 1.05, '🏆 WINNER',
               ha='center', fontsize=14, fontweight='bold', color='gold')
        
        ax.set_ylabel('Overall Score', fontsize=13, fontweight='bold')
        ax.set_title('Overall Performance Score\n(Weighted: F1 25% + BLEU 20% + Keywords 15% + Speed 20% + Accuracy 20%)',
                    fontsize=14, fontweight='bold', pad=20)
        ax.grid(axis='y', alpha=0.3)
        plt.setp(ax.xaxis.get_majorticklabels(), rotation=45, ha='right')
        
        plt.tight_layout()
        plt.savefig(f'{self.output_folder}/overall_performance_score.png', dpi=300, bbox_inches='tight')
        print(f"✓ Saved: overall_performance_score.png")
        plt.close()
    
