            }
        }
        
        self.system_prompt = """You are TAR UMT Student Assistant, a helpful and friendly chatbot representing Tunku Abdul Rahman University of Management and Technology (TAR UMT). 

IMPORTANT: You MUST respond ONLY in English language. Never use Bahasa Malaysia or any other language.

Your role:
- Provide accurate information about TAR UMT based on the context given
- Be warm, professional, and student-friendly
- Keep responses concise (under 200 words) but informative
- If information is not in the context, politely say so and direct to relevant contacts
- Use emojis occasionally to make responses engaging
- Always promote TAR UMT's values: Beyond Education philosophy, quality education, and student success

Remember: TAR UMT is rated 'Berdaya Saing (Competitive)' in SETARA rating and has 34,000+ students across 6 campuses in Malaysia."""
    
    def load_faq_dataset(self):
        """Load FAQ dataset from CSV file"""
        try:
            import os
            
            # Get current working directory
            current_dir = os.getcwd()
            print(f"📂 Current directory: {current_dir}")
            
            # Try different possible file locations
            possible_paths = [
                "TARUMT_FAQ.csv",
                "tarumt_faq.csv",
                "./TARUMT_FAQ.csv",
                "../TARUMT_FAQ.csv",
                "dataset/TARUMT_FAQ.csv",
                "./dataset/TARUMT_FAQ.csv",
                "university_chatbot/dataset/TARUMT_FAQ.csv",
                os.path.join(current_dir, "dataset", "TARUMT_FAQ.csv"),
                os.path.join(current_dir, "TARUMT_FAQ.csv")
            ]
            
            print("🔍 Searching for CSV file in these locations:")
            for path in possible_paths:
                exists = Path(path).exists()
                print(f"   {'✅' if exists else '❌'} {path}")
                
                if exists:
                    self.faq_data = pd.read_csv(path, encoding='utf-8')
                    self.faq_loaded = True
                    
                    # Clean column names (remove extra spaces)
                    self.faq_data.columns = self.faq_data.columns.str.strip()
                    
                    # Display dataset info
                    print(f"\n✅ FAQ Dataset loaded successfully from: {path}")
                    print(f"   Total FAQs: {len(self.faq_data)}")
                    print(f"   Columns: {', '.join(self.faq_data.columns)}")
                    return True
            
            print("\n⚠ FAQ dataset not found in any location. Using fallback knowledge base.")
            print(f"💡 Please place TARUMT_FAQ.csv in: {os.path.join(current_dir, 'dataset')}")
            return False
            
        except Exception as e:
            print(f"❌ Error loading FAQ dataset: {str(e)}")
            import traceback
            traceback.print_exc()
            self.faq_loaded = False
            return False
    
    def search_faq(self, query, top_n=3):
        """Search FAQ dataset for relevant answers"""
        if not self.faq_loaded or self.faq_data is None:
            return []
        
        try:
            query_lower = query.lower()
            results = []
            
            # Assume CSV has columns: 'Question' and 'Answer' (adjust as needed)
            # Check what columns your CSV actually has
            question_col = None
            answer_col = None
            
            # Try to find question and answer columns
            for col in self.faq_data.columns:
                col_lower = col.lower()
                if 'question' in col_lower or 'query' in col_lower or 'q' == col_lower:
                    question_col = col
                elif 'answer' in col_lower or 'response' in col_lower or 'a' == col_lower:
                    answer_col = col
            
            if not question_col or not answer_col:
                print(f"⚠ Could not identify question/answer columns. Available: {self.faq_data.columns.tolist()}")
                return []
            
            # Search through FAQs
            for idx, row in self.faq_data.iterrows():
                question = str(row[question_col]).lower()
                answer = str(row[answer_col])
                
                # Simple keyword matching (you can improve this with better NLP)
                if any(word in question for word in query_lower.split()):
                    results.append({
                        'question': row[question_col],
                        'answer': answer,
                        'relevance': sum(word in question for word in query_lower.split())
                    })
            
            # Sort by relevance and return top N
            results.sort(key=lambda x: x['relevance'], reverse=True)
            return results[:top_n]
            
        except Exception as e:
            print(f"❌ Error searching FAQ: {str(e)}")
            return []
    
    def check_available_models(self):
        """Check available Ollama models"""
        try:
            response = requests.get(f"{self.base_url}/api/tags", timeout=5)
            if response.status_code == 200:
                data = response.json()
                models = [model['name'] for model in data.get('models', [])]
                return models
            return []
        except:
            return []
    
    def detect_intent(self, message):
        """Detect user intent"""
        message_lower = message.lower()
        
        for category, data in self.knowledge_base.items():
            for keyword in data["keywords"]:
                if keyword in message_lower:
                    return category
        return None
    
    def get_icon(self, intent):
        """Get icon for intent"""
        if intent and intent in self.knowledge_base:
            return self.knowledge_base[intent]["icon"]
        return "💬"
    
    def get_badge_class(self, intent):
        """Get CSS class for intent badge"""
        if intent:
            return f"badge-{intent}"
        return ""
    
    def get_url(self, intent):
        """Get URL for intent"""
        if intent and intent in self.knowledge_base:
            return self.knowledge_base[intent]["url"]
        return "#"
    
    def generate_response(self, user_message):
        """Generate AI response using CSV dataset"""
        start_time = time.time()
        
        try:
            intent = self.detect_intent(user_message)
            
            # First, search FAQ dataset
            faq_results = self.search_faq(user_message)
            
            # Build context from FAQ results
            context = ""
            if faq_results:
                context = "Relevant FAQ Information:\n\n"
                for i, result in enumerate(faq_results, 1):
                    context += f"Q{i}: {result['question']}\n"
                    context += f"A{i}: {result['answer']}\n\n"
            
            # Create prompt with FAQ context
            if context:
                full_prompt = f"""{self.system_prompt}

{context}

Student Question: {user_message}

Your Response (use the FAQ information above to answer):"""
            else:
                full_prompt = f"""{self.system_prompt}

Student Question: {user_message}

Your Response:"""
            
            # Optimized settings for llama3.2:3b
            payload = {
                "model": self.model_name,
                "prompt": full_prompt,
                "stream": False,
                "options": {
                    "temperature": 0.7,
                    "num_predict": 200,
                    "num_ctx": 2048,
                    "num_batch": 512,
                    "num_gpu": 1,
                    "num_thread": 4,
                    "top_p": 0.9,
                    "top_k": 40,
                    "repeat_penalty": 1.1
                }
            }
            
            response = requests.post(
                self.api_endpoint,
                json=payload,
                timeout=60
            )
            
            response_time = time.time() - start_time
            
            if response.status_code == 200:
                result = response.json()
                bot_response = result.get("response", "").strip()
                return bot_response, intent, response_time, len(faq_results)
            elif response.status_code == 404:
                available_models = self.check_available_models()
                error_msg = f"❌ Model '{self.model_name}' not found!\n\n"
                if available_models:
                    error_msg += f"Available models: {', '.join(available_models)}\n\n"
                    error_msg += "Please update model in sidebar."
                else:
                    error_msg += "Run: ollama pull llama3.2:3b"
                return error_msg, None, response_time, 0
            else:
                return f"Error: Status {response.status_code}", None, response_time, 0
                
        except requests.exceptions.ConnectionError:
            return "❌ Cannot connect to Ollama! Please run: ollama serve", None, 0, 0
        except requests.exceptions.Timeout:
            return "⏱ Request timed out. The model might be loading. Please try again.", None, 0, 0
        except Exception as e:
            return f"❌ Error: {str(e)}", None, 0, 0


