        st.divider()
        
        # Action buttons
        col1, col2 = st.columns(2)
        with col1:
            if st.button("🗑 Clear Chat", use_container_width=True):
                st.session_state.messages = []
                st.session_state.total_queries = 0
                st.session_state.intent_counts = {}
                st.session_state.total_response_time = 0
                st.session_state.faq_hits = 0
                st.rerun()
        
        with col2:
            if st.button("💾 Export", use_container_width=True):
                if st.session_state.messages:
                    data = {
                        "timestamp": datetime.now().isoformat(),
                        "university": "TAR UMT",
                        "total_queries": st.session_state.total_queries,
                        "faq_dataset_loaded": st.session_state.chatbot.faq_loaded,
                        "messages": st.session_state.messages
                    }
                    st.download_button(
                        "📥 Download JSON",
                        data=json.dumps(data, indent=2),
                        file_name=f"tar_umt_chat_{datetime.now().strftime('%Y%m%d_%H%M%S')}.json",
                        mime="application/json"
                    )
    
    # Display chat messages
    for message in st.session_state.messages:
        role = message["role"]
        content = message["content"]
        
        if role == "user":
            with st.chat_message("user", avatar="👤"):
                st.write(content)
        else:
            with st.chat_message("assistant", avatar="🎓"):
                st.write(content)
                
                if "intent" in message and message["intent"]:
                    intent = message["intent"]
                    icon = st.session_state.chatbot.get_icon(intent)
                    badge_class = st.session_state.chatbot.get_badge_class(intent)
                    url = st.session_state.chatbot.get_url(intent)
                    
                    # Create clickable badge with URL
                    badge_html = f'''
                    <a href="{url}" target="_blank" class="intent-badge {badge_class}">
                        {icon} {intent.title()} → Click to learn more
                    </a>
                    '''
                    st.markdown(badge_html, unsafe_allow_html=True)
                
                if "faq_matches" in message and message["faq_matches"] > 0:
                    st.caption(f"📚 Found {message['faq_matches']} relevant FAQs")
                
                if "response_time" in message:
                    st.caption(f"⚡ Response time: {message['response_time']:.2f}s")
                    
                # Add quick action buttons for common intents
                if "intent" in message and message["intent"]:
                    intent = message["intent"]
                    if intent in ["programs", "admission", "fees"]:
                        st.markdown("---")
                        st.markdown("🚀 Quick Actions:")
                        
                        quick_actions = {
                            "programs": {"url": "https://www.tarc.edu.my/admissions/programmes/programme-offered-a-z/undergraduate-programme/", "text": "📚 Browse All Programs"},
                            "admission": {"url": "https://www.tarc.edu.my/account/login.jsp?fappcode=online-app", "text": "📝 Apply Now"},
                            "fees": {"url": "https://www.tarc.edu.my/apply-and-study/fees/malaysians-student-fees/", "text": "💰 Fee Structure"}
                        }
                        
                        if intent in quick_actions:
                            action = quick_actions[intent]
                            button_html = f'''
                            <a href="{action['url']}" target="_blank" style="text-decoration: none;">
                                <button class="quick-action-button" style="background: linear-gradient(135deg, #db2777, #be185d);">
                                    {action['text']}
                                </button>
                            </a>
                            '''
                            st.markdown(button_html, unsafe_allow_html=True)
    
    # Chat input
    if "user_input" in st.session_state:
        user_input = st.session_state.user_input
        del st.session_state.user_input
    else:
        user_input = st.chat_input("💬 Ask me anything about TAR UMT...")
    
    if user_input:
        # Add user message
        st.session_state.messages.append({
            "role": "user",
            "content": user_input,
            "timestamp": datetime.now().isoformat()
        })
        
        # Generate response
        with st.spinner("🤔 Thinking... Please wait"):
            bot_response, intent, response_time, faq_matches = st.session_state.chatbot.generate_response(user_input)
        
        # Add bot message
        st.session_state.messages.append({
            "role": "assistant",
            "content": bot_response,
            "intent": intent,
            "response_time": response_time,
            "faq_matches": faq_matches,
            "timestamp": datetime.now().isoformat()
        })
        
        # Update statistics
        st.session_state.total_queries += 1
        st.session_state.total_response_time += response_time
        if faq_matches > 0:
            st.session_state.faq_hits += 1
        
        if intent:
            st.session_state.intent_counts[intent] = st.session_state.intent_counts.get(intent, 0) + 1
        
        st.rerun()
    
    # Footer
    st.markdown("""
    <div class="footer">
        <strong>TAR UMT Student Assistant</strong> | Powered by Ollama & Streamlit<br>
        📍 Jalan Genting Kelang, Setapak, 53300 Kuala Lumpur<br>
        📞 +603-4145 0100 | 📧 info@tarc.edu.my | 🌐 www.tarc.edu.my<br>
        <br>
        <em>Beyond Education • Industry-Ready Graduates • 34,000+ Students • 6 Campuses</em>
    </div>
    """, unsafe_allow_html=True)


if __name__ == "__main__":
    main()
